.venv/
.venv314t/
__pycache__/
*.pyc

# built firmware and its manifests
firmware/*.elf
firmware/*.json
firmware/*.bin
firmware_ni/

# LaTeX build artifacts (report/ucpqc_report.*); the .pdf is tracked, these are not
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
report/*.log
report/*.out
report/*.toc

# analysis output
*.npy
*.csv

# fault-analysis dumps (sweep --dump / funcskip --dump); generated data, not source
/dump/
/dumps/
/dumps_ctrl/
/dumps_mayo/
/dumps_snap/
*_instrskip/
funcskip_sweep/
# persistent funcskip capture cache (ucpqc capture --out); regenerable, ~20MB
/captures/
/captures_m4f/
/captures_ctrl/
/dumps_mayo_ni/
/dumps_ctrl_pa/
/dumps_ctrl_pa_dumps/
